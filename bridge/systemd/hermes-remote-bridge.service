[Unit]
Description=Hermes Mobile Remote bridge
Documentation=https://github.com/nideta231/hermes-mobile-remote
After=network-online.target hermes-gateway.service
Wants=hermes-gateway.service

[Service]
Type=simple
# install.sh replaces @BIN@ with the bridge's virtualenv entry point.
ExecStart=@BIN@ serve
# The bridge exits when the network changes; systemd restarts it on the new addresses.
Restart=always
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=%h/.config/hermes-remote %h/.local/state/hermes-remote
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077

[Install]
WantedBy=default.target
