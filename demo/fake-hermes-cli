#!/usr/bin/env python3
"""A stand-in for the `hermes` CLI, used only by the demo bridge.

The real bridge shells out to Hermes for exactly two things: reading and writing
`approvals.mode`, and reading `agent.reasoning_effort`. Pointing those at this script keeps the
demo from reading or changing the real Hermes configuration on this machine.

Values live in a JSON file next to the script (demo/.state/hermes-config.json).
"""
from __future__ import annotations

import json
import os
import sys
from pathlib import Path

STORE = Path(os.environ.get("DEMO_HERMES_CONFIG", Path(__file__).with_suffix(".config.json")))

DEFAULTS = {"approvals.mode": "manual", "agent.reasoning_effort": "medium"}


def load() -> dict:
    try:
        return {**DEFAULTS, **json.loads(STORE.read_text())}
    except (OSError, ValueError):
        return dict(DEFAULTS)


def save(data: dict) -> None:
    STORE.parent.mkdir(parents=True, exist_ok=True)
    STORE.write_text(json.dumps(data, indent=2) + "\n")


def main(argv: list[str]) -> int:
    if len(argv) >= 2 and argv[0] == "config":
        data = load()
        if argv[1] == "get" and len(argv) >= 3:
            print(data.get(argv[2], ""))
            return 0
        if argv[1] == "set" and len(argv) >= 4:
            data[argv[2]] = argv[3]
            save(data)
            print(f"{argv[2]} = {argv[3]}")
            return 0
    print(f"demo hermes CLI: unsupported command {' '.join(argv)!r}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
